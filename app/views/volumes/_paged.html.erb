<%
  # Se resuelve una sola vez: next_volume consulta los tomos de la serie.
  next_volume = @page_number >= @volume.page_count - 1 ? @volume.next_volume : nil

  previous_page_url = if @page_number > 0
    volume_path(@volume, page: @page_number - 1, mode: "paged")
  elsif @volume.previous_volume
    volume_path(@volume.previous_volume, page: @volume.previous_volume.page_count - 1, mode: "paged")
  end

  next_page_url = if @page_number < @volume.page_count - 1
    volume_path(@volume, page: @page_number + 1, mode: "paged")
  elsif next_volume
    volume_path(next_volume, page: 0, mode: "paged")
  end

  # Imágenes que el navegador descarga mientras se lee la página actual, para
  # que al pasar de hoja ya estén listas y no haya que esperarlas (el trabajo
  # lo hace reader_controller.js). Se precargan las dos siguientes y la
  # anterior, que cubren tanto avanzar como volver atrás.
  preload_urls = (1..2).filter_map do |offset|
    following = @page_number + offset
    page_volume_path(@volume, number: following) if following < @volume.page_count
  end
  preload_urls << page_volume_path(@volume, number: @page_number - 1) if @page_number > 0
  preload_urls << page_volume_path(next_volume, number: 0) if next_volume

  # Zonas transparentes que ocupan un tercio a cada lado para pasar de página.
  # El tercio del medio queda libre a propósito: ahí el doble clic hace zoom
  # sin pelearse con el clic que cambia de hoja.
  side_zone_classes = "absolute inset-y-0 w-1/3 group-data-zoomed:cursor-grab"

  button_classes = "px-4 py-2 rounded border border-gray-300 dark:border-gray-700 hover:bg-gray-100 dark:hover:bg-gray-800"
  disabled_button_classes = "px-4 py-2 rounded border border-gray-200 dark:border-gray-800 text-gray-400 dark:text-gray-600"
%>

<%# Los atributos data-fullscreen y data-zoomed los pone y los saca
    reader_controller.js; de ellos cuelgan las variantes group-data-* de este
    partial. %>
<div data-controller="reader"
     data-reader-previous-url-value="<%= previous_page_url %>"
     data-reader-next-url-value="<%= next_page_url %>"
     data-reader-preload-urls-value="<%= preload_urls.to_json %>"
     class="group flex flex-col items-center gap-4
            data-fullscreen:fixed data-fullscreen:inset-0 data-fullscreen:z-50
            data-fullscreen:gap-0 data-fullscreen:bg-black">

  <%# overflow-hidden recorta la página ampliada al escenario; sin esto el
      zoom se derrama sobre el resto de la pantalla. %>
  <div data-reader-target="stage"
       data-action="pointerdown->reader#startGesture dblclick->reader#toggleZoom"
       class="relative flex w-full items-center justify-center overflow-hidden min-h-[80dvh]
              group-data-zoomed:touch-none
              group-data-fullscreen:h-dvh group-data-fullscreen:min-h-0 group-data-fullscreen:touch-none">
    <% if previous_page_url %>
      <%= link_to previous_page_url, class: "#{side_zone_classes} left-0", draggable: false, "aria-label": "Página anterior" do %><% end %>
    <% end %>

    <%# h-[80dvh] en vez de max-h-: con max- una página de origen chica se
        quedaba en su tamaño nativo; así siempre ocupa el alto disponible, y
        object-contain evita que se deforme cuando max-w-full la limita. %>
    <%= image_tag page_volume_path(@volume, number: @page_number),
          class: "h-[80dvh] w-auto max-w-full object-contain origin-center rounded shadow-lg select-none
                  group-data-fullscreen:h-dvh group-data-fullscreen:w-full
                  group-data-fullscreen:rounded-none group-data-fullscreen:shadow-none",
          alt: "Página #{@page_number + 1}",
          draggable: false,
          data: { reader_target: "image" } %>

    <% if next_page_url %>
      <%= link_to next_page_url, class: "#{side_zone_classes} right-0", draggable: false, "aria-label": "Página siguiente" do %><% end %>
    <% end %>
  </div>

  <%# En pantalla completa la barra desaparece del todo: tapaba la lectura y
      las dos acciones que ofrecía ya están en los costados y en Escape. %>
  <div class="flex items-center gap-4 group-data-fullscreen:hidden">
    <% if previous_page_url %>
      <%= link_to "← Anterior", previous_page_url, class: button_classes %>
    <% else %>
      <span class="<%= disabled_button_classes %>">← Anterior</span>
    <% end %>

    <button type="button"
            data-action="reader#toggleFullscreen"
            data-reader-target="toggle"
            aria-pressed="false"
            title="Pantalla completa (F) — Escape para salir, doble clic o rueda para acercar"
            class="<%= button_classes %> flex items-center gap-2">
      <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor"
           stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3m0 18h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2h3" />
      </svg>
      Pantalla completa
    </button>

    <% if next_page_url %>
      <%= link_to "Siguiente →", next_page_url, class: button_classes %>
    <% else %>
      <span class="<%= disabled_button_classes %>">Siguiente →</span>
    <% end %>
  </div>
</div>
