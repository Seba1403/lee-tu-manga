<%
  # Se resuelve una sola vez: next_volume consulta los tomos de la serie.
  next_volume = @page_number >= @volume.page_count - 1 ? @volume.next_volume : nil

  previous_page_url = if @page_number > 0
    volume_path(@volume, page: @page_number - 1, mode: "paged")
  elsif @volume.previous_volume
    volume_path(@volume.previous_volume, page: @volume.previous_volume.page_count - 1, mode: "paged")
  end

  next_page_url = if @page_number < @volume.page_count - 1
    volume_path(@volume, page: @page_number + 1, mode: "paged")
  elsif next_volume
    volume_path(next_volume, page: 0, mode: "paged")
  end

  # Imágenes que el navegador descarga mientras se lee la página actual, para
  # que al pasar de hoja ya estén listas y no haya que esperarlas (el trabajo
  # lo hace reader_controller.js). Se precargan las dos siguientes y la
  # anterior, que cubren tanto avanzar como volver atrás.
  preload_urls = (1..2).filter_map do |offset|
    following = @page_number + offset
    page_volume_path(@volume, number: following) if following < @volume.page_count
  end
  preload_urls << page_volume_path(@volume, number: @page_number - 1) if @page_number > 0
  preload_urls << page_volume_path(next_volume, number: 0) if next_volume
%>

<div data-controller="reader"
     data-reader-previous-url-value="<%= previous_page_url %>"
     data-reader-next-url-value="<%= next_page_url %>"
     data-reader-preload-urls-value="<%= preload_urls.to_json %>"
     class="flex flex-col items-center gap-4">

  <div class="relative flex justify-center items-center w-full min-h-[70vh]">
    <% if previous_page_url %>
      <%= link_to previous_page_url, class: "absolute inset-y-0 left-0 w-1/3", "aria-label": "Página anterior" do %><% end %>
    <% end %>

    <%= image_tag page_volume_path(@volume, number: @page_number),
          class: "max-h-[85vh] max-w-full w-auto rounded shadow-lg select-none",
          alt: "Página #{@page_number + 1}" %>

    <% if next_page_url %>
      <%= link_to next_page_url, class: "absolute inset-y-0 right-0 w-1/3", "aria-label": "Página siguiente" do %><% end %>
    <% end %>
  </div>

  <div class="flex items-center gap-4">
    <% if previous_page_url %>
      <%= link_to "← Anterior", previous_page_url, class: "px-4 py-2 rounded border border-gray-300 dark:border-gray-700 hover:bg-gray-100 dark:hover:bg-gray-800" %>
    <% else %>
      <span class="px-4 py-2 rounded border border-gray-200 dark:border-gray-800 text-gray-400 dark:text-gray-600">← Anterior</span>
    <% end %>

    <% if next_page_url %>
      <%= link_to "Siguiente →", next_page_url, class: "px-4 py-2 rounded border border-gray-300 dark:border-gray-700 hover:bg-gray-100 dark:hover:bg-gray-800" %>
    <% else %>
      <span class="px-4 py-2 rounded border border-gray-200 dark:border-gray-800 text-gray-400 dark:text-gray-600">Siguiente →</span>
    <% end %>
  </div>
</div>
