<% content_for :title, "Iniciar sesión" %>

<div class="max-w-sm mx-auto">
  <h1 class="text-xl font-semibold mb-6">Iniciar sesión</h1>

  <%= form_with url: session_path, method: :post, class: "flex flex-col gap-4" do |form| %>
    <div>
      <%= form.label :username, "Usuario", class: "block text-sm mb-1" %>
      <%= form.text_field :username, autofocus: true, autocomplete: "username",
            class: "w-full rounded border border-gray-300 dark:border-gray-700 bg-transparent px-3 py-2" %>
    </div>

    <div>
      <%= form.label :password, "Contraseña", class: "block text-sm mb-1" %>
      <%= form.password_field :password, autocomplete: "current-password",
            class: "w-full rounded border border-gray-300 dark:border-gray-700 bg-transparent px-3 py-2" %>
    </div>

    <%= form.submit "Entrar", class: "px-4 py-2 rounded bg-gray-900 text-white dark:bg-gray-100 dark:text-gray-900 cursor-pointer" %>
  <% end %>
</div>
