# Copiar a .env (no se commitea) en /opt/stacks/projects/lee-tu-manga-stack/ y completar.

# Generar con: bin/rails secret
SECRET_KEY_BASE=

# Puerto en localhost de la Pi donde Cloudflare Tunnel debe apuntar.
APP_PORT=3050

# Usuario y contraseña únicos para iniciar sesión (solo protege "Actualizar
# biblioteca"; leer manga no requiere login). Se crean/actualizan solos la
# primera vez que arranca el contenedor (db/seeds.rb). Para cambiar la
# contraseña más adelante: editar acá y correr
# `docker compose exec web bin/rails db:seed`.
OWNER_USERNAME=
OWNER_PASSWORD=
